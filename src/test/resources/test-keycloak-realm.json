{
  "id": "trino-realm",
  "realm": "trino-realm",
  "enabled": true,
  "clients": [
    {
      "clientId": "sample-client-id",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "secret",
